# Copy to .env and adjust. Values here are development defaults.

APP_ENV=development
LOG_LEVEL=info

# HTTP server
HTTP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost,capacitor://localhost,http://192.168.1.152:5173

# Database (MySQL 8+, database name trimobase)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=trimobase

# Auth — REQUIRED. Use a long, random secret in production.
JWT_SECRET=dev-only-change-me-to-a-long-random-string
JWT_ISSUER=trimo
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Image uploads (Firebase Storage / Google Cloud Storage).
# Leave STORAGE_BUCKET empty to disable uploads. The bucket must be publicly
# readable so the returned URLs work (grant allUsers the Storage Object Viewer
# role on the bucket). GOOGLE_APPLICATION_CREDENTIALS points at a service-account
# JSON key with storage access.
STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
STORAGE_PUBLIC_BASE_URL=https://storage.googleapis.com
STORAGE_MAX_UPLOAD_BYTES=5242880
